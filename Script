---------------------------------------------------------------------
local function addCorner(obj, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = obj
end

local function styleText(obj, size)
	obj.Font = Enum.Font.GothamBold
	obj.TextSize = size or 15
	obj.TextColor3 = Color3.new(1, 1, 1)
end

local function getPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function getPosition(obj)
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	end
	local part = getPart(obj)
	return part and part.Position
end

-- True if the object is part of, carried by, or welded to any player's character
local function isOnPlayer(obj)
	local part = getPart(obj)
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char then
			if obj == char or obj:IsDescendantOf(char) then
				return true
			end
			local root = char:FindFirstChild("HumanoidRootPart")
			if part and root and part.AssemblyRootPart == root.AssemblyRootPart then
				return true
			end
		end
	end
	return false
end

-- Extends a line from a start point in a direction until it hits the screen edge
local function toScreenEdge(start, direction, viewport)
	local tx, ty = math.huge, math.huge
	if direction.X > 0 then
		tx = (viewport.X - start.X) / direction.X
	elseif direction.X < 0 then
		tx = -start.X / direction.X
	end
	if direction.Y > 0 then
		ty = (viewport.Y - start.Y) / direction.Y
	elseif direction.Y < 0 then
		ty = -start.Y / direction.Y
	end
	return start + direction * math.min(tx, ty)
end

-- Draws a tracer line (also works when the target is behind the camera)
local function drawTracer(line, camera, viewport, origin, pos, color, thickness)
	local screen = camera:WorldToViewportPoint(pos)
	local target
	if screen.Z > 0 then
		target = Vector2.new(screen.X, screen.Y)
	else
		local rel = camera.CFrame:PointToObjectSpace(pos)
		local direction = Vector2.new(rel.X, -rel.Y)
		if direction.Magnitude < 0.001 then
			direction = Vector2.new(0, 1)
		end
		target = toScreenEdge(origin, direction.Unit, viewport)
	end

	local diff = target - origin
	local middle = (origin + target) / 2
	line.Size = UDim2.fromOffset(diff.Magnitude, thickness)
	line.Position = UDim2.fromOffset(middle.X, middle.Y)
	line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
	line.BackgroundColor3 = color
	line.Visible = true
end

