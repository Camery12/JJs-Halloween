	if waitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
		waitingForKey = false
		settings.menuKey = input.KeyCode.Name
		redrawAll()
		return
	end
	if gameProcessed then return end
	if input.KeyCode.Name == settings.menuKey then
		toggleMenu()
	end
end)

