-- Find doors (Workspace.Effects)
---------------------------------------------------------------------
task.spawn(function()
	local effects = workspace:WaitForChild("Effects", 15)
	if not effects then
		warn("[ESP] Workspace.Effects not found!")
		return
	end

	local function checkDoor(obj)
		if obj.Name == DOOR_NAME and obj:IsA("PVInstance") then
			addTarget(obj, "door")
		end
	end

	for _, obj in ipairs(effects:GetChildren()) do
		checkDoor(obj)
	end
	effects.ChildAdded:Connect(checkDoor)
	effects.ChildRemoved:Connect(removeTarget)

	doorScanDone = true
	print("[ESP] Doors ready.")
end)

---------------------------------------------------------------------
-- Find items (Workspace.Items)
---------------------------------------------------------------------
task.spawn(function()
	local folder
	local startTime = os.clock()
	while not folder and os.clock() - startTime < 15 do
		for _, name in ipairs(ITEM_FOLDER_NAMES) do
			folder = folder or workspace:FindFirstChild(name)
		end
		if not folder then task.wait(0.5) end
	end

	if not folder then
		warn("[ESP] Workspace.Items not found!")
		return
	end

	for _, obj in ipairs(folder:GetChildren()) do
		addTarget(obj, "item")
	end
	folder.ChildAdded:Connect(function(obj)
		addTarget(obj, "item")
	end)
	folder.ChildRemoved:Connect(removeTarget)

	print("[ESP] Items ready.")
end)
