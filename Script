-- Every frame: highlights, labels, tracers, counter
---------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize

	local origin
	if settings.tracerOrigin == "Bottom" then
		origin = Vector2.new(viewport.X / 2, viewport.Y - 5)
	elseif settings.tracerOrigin == "Top" then
		origin = Vector2.new(viewport.X / 2, 5)
	elseif settings.tracerOrigin == "Mouse" then
		origin = UserInputService:GetMouseLocation()
	else
		origin = viewport / 2
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local myPos = root and root.Position or camera.CFrame.Position

	local doorColor = COLORS[settings.doorColorIndex].color
	local itemColor = COLORS[settings.itemColorIndex].color

	-- Positions & distances
	local doorCount, itemCount = 0, 0
	local nearestDoor, nearestDist = nil, math.huge
	local itemList = {}
	for obj, data in pairs(targets) do
		data.pos = getPosition(obj)
		data.dist = data.pos and (data.pos - myPos).Magnitude or math.huge
		if data.kind == "door" then
			doorCount += 1
			if data.dist < nearestDist then
				nearestDoor, nearestDist = obj, data.dist
			end
		else
			itemCount += 1
			table.insert(itemList, data)
		end
	end

	-- Only the closest items get a highlight (Roblox limit)
	table.sort(itemList, function(a, b) return a.dist < b.dist end)
	for i, data in ipairs(itemList) do
		data.highlight.Enabled = settings.itemEspEnabled and i <= MAX_ITEM_HIGHLIGHTS
	end

	for obj, data in pairs(targets) do
		-- Never mark anything attached to a player
		if isOnPlayer(obj) then
			removeTarget(obj)
			continue
		end

		local isDoor = data.kind == "door"
		local isNearest = isDoor and settings.nearestEnabled and obj == nearestDoor

		local color
		if isNearest then
			color = NEAREST_COLOR
		elseif isDoor then
			color = doorColor
		else
			color = itemColor
		end

		-- Highlight
		if isDoor then
			data.highlight.Enabled = settings.doorEspEnabled
		end
		if not data.highlight.Adornee then
			data.highlight.Adornee = getPart(obj)
		end
		if data.highlight.FillColor ~= color then
			data.highlight.FillColor = color
			data.highlight.OutlineColor = color
		end
		if data.highlight.FillTransparency ~= settings.fillTransparency then
			data.highlight.FillTransparency = settings.fillTransparency
		end

		-- Label above the object
		local showLabel, showTracer
		if isDoor then
			showLabel = settings.doorDistanceEnabled
			showTracer = settings.doorTracersEnabled
		else
			showLabel = settings.itemEspEnabled and settings.itemNamesEnabled
			showTracer = settings.itemEspEnabled and settings.itemTracersEnabled
		end

		data.billboard.Enabled = showLabel and data.pos ~= nil
		if showLabel and data.pos then
			if not data.billboard.Adornee then
				data.billboard.Adornee = getPart(obj)
			end
			local studs = math.floor(data.dist) .. " studs"
			data.label.Text = isDoor and studs or (obj.Name .. " (" .. studs .. ")")
			data.label.TextColor3 = color
		end

		-- Tracer
		if showTracer and data.pos then
			local thickness = settings.tracerThickness + (isNearest and 2 or 0)
			drawTracer(data.tracer, camera, viewport, origin, data.pos, color, thickness)
		else
			data.tracer.Visible = false
		end
	end

	-- Counter on the left
	if counter.Visible then
		local lines = {}
		if settings.counterEnabled then
			table.insert(lines, "🚪 Doors: " .. doorCount)
			if nearestDoor then
				table.insert(lines, "📍 Nearest: " .. math.floor(nearestDist) .. " studs")
			end
		end
		if settings.itemEspEnabled and settings.itemCounterEnabled then
			table.insert(lines, "📦 Items: " .. itemCount)
		end
		counter.Text = table.concat(lines, "\n")
	end
end)

