local targets = {} -- [object] = { kind, highlight, billboard, label, tracer, pos, dist }
local doorScanDone = false

local function refresh()
	counter.Visible = settings.counterEnabled or (settings.itemEspEnabled and settings.itemCounterEnabled)
	counterStroke.Color = COLORS[settings.doorColorIndex].color
	setInstantPrompts(settings.instantPromptEnabled)
end

local function removeTarget(obj)
	local data = targets[obj]
	if not data then return end
	data.highlight:Destroy()
	data.billboard:Destroy()
	data.tracer:Destroy()
	targets[obj] = nil
end

local function addTarget(obj, kind)
	if targets[obj] or isOnPlayer(obj) then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ESPHighlight"
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	if obj:IsA("Model") or obj:IsA("BasePart") then
		highlight.Adornee = obj
	else
		highlight.Adornee = getPart(obj)
	end
	highlight.Parent = obj

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(kind == "item" and 220 or 120, 24)
	billboard.StudsOffset = Vector3.new(0, kind == "item" and 2.5 or 5, 0)
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.Adornee = getPart(obj)
	billboard.Parent = screenGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextStrokeTransparency = 0.3
	styleText(label, 14)
	label.Parent = billboard

	local tracer = Instance.new("Frame")
	tracer.AnchorPoint = Vector2.new(0.5, 0.5)
	tracer.BorderSizePixel = 0
	tracer.Visible = false
	tracer.Parent = tracerLayer

	targets[obj] = { kind = kind, highlight = highlight, billboard = billboard, label = label, tracer = tracer }

	-- Opened / picked up / deleted -> remove
	obj.AncestryChanged:Connect(function()
		if not obj:IsDescendantOf(workspace) then
			removeTarget(obj)
		end
	end)

	if kind == "door" and doorScanDone and settings.notifyEnabled then
		notify("🚪 New door appeared!")
	end
end

