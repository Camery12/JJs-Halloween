---------------------------------------------------------------------
-- Prompts (Instant Prompt / No Instant Prompt)
---------------------------------------------------------------------
-- Every ProximityPrompt we have seen, with its normal hold duration
local originalHold = setmetatable({}, { __mode = "k" }) -- [prompt] = normal HoldDuration
local instantActive = false

-- Puts a prompt into the correct state (instant or normal)
local function applyPrompt(prompt)
	local normal = originalHold[prompt]
	if normal == nil then return end
	local wanted = instantActive and 0 or normal
	if prompt.HoldDuration ~= wanted then
		prompt.HoldDuration = wanted
	end
end

-- Starts tracking a prompt (existing or future)
local function trackPrompt(obj)
	if not obj:IsA("ProximityPrompt") or originalHold[obj] ~= nil then return end
	originalHold[obj] = obj.HoldDuration

	-- If the game changes the hold time later, remember it as the new normal value
	obj:GetPropertyChangedSignal("HoldDuration"):Connect(function()
		local value = obj.HoldDuration
		if instantActive then
			if value ~= 0 then
				originalHold[obj] = value
				obj.HoldDuration = 0
			end
		else
			originalHold[obj] = value
		end
	end)

	applyPrompt(obj)
end

local function countPrompts()
	local count = 0
	for prompt in pairs(originalHold) do
		if prompt.Parent then count += 1 end
	end
	return count
end

local function setInstantPrompts(enabled)
	if enabled == instantActive then return end
	instantActive = enabled
	for prompt in pairs(originalHold) do
		applyPrompt(prompt)
	end
end

-- Track all prompts that exist now and every prompt that appears later
for _, obj in ipairs(workspace:GetDescendants()) do
	trackPrompt(obj)
end
workspace.DescendantAdded:Connect(trackPrompt)

